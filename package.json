{
  "name": "classless-survivors",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A classless dark fantasy survival roguelite for the browser.",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "release": "node scripts/package-release.mjs",
    "test:release": "node scripts/smoke-release.mjs",
    "analyze": "node analysis/run.mjs",
    "analyze:browser": "node analysis/browser.mjs",
    "check": "npm run test && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
